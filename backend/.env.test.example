# Copy to backend/.env.test. Dummy values only: the suite sets its own secrets.
#
# The only thing the tests need from you is a database they may empty.
# The name must contain "test" and it must not be the live database.
#
# With Docker (npm run test:db:up from the repo root):
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:55432/leviaan_test
#
# With a Postgres already on this machine, make the database once:
#   createdb leviaan_test
# and use:
# TEST_DATABASE_URL=postgresql://postgres:WACHTWOORD@localhost:5432/leviaan_test
